FLIGHTPOWERS_API_KEY=
SERPAPI_API_KEY=
TRAVELPAYOUTS_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# https://rapidapi.com/DataCrawler/api/google-flights2
DATACRAWLER_API_KEY=
DATACRAWLER_MAX_REQUESTS_PER_RUN=5

# Nivel de logs del backend y worker (copiar a .env y recrear los servicios).
# Valores, de más a menos detalle; cada nivel incluye los de mayor gravedad:
# DEBUG: consultas por proveedor, resultados y límites de peticiones.
# INFO: inicio/fin de búsquedas, totales y actividad del worker (predeterminado).
# WARNING: avisos, como el uso del modo demo.
# ERROR: fallos de proveedores o ejecuciones. CRITICAL: solo fallos críticos.
# Se aceptan minúsculas; un valor inválido impide el arranque.
# Salida a consola: docker compose logs -f backend worker
LOG_LEVEL=INFO

# APIs adicionales. Amadeus test se muestra en Demostración.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_PRODUCTION=false
KIWI_API_KEY=

# Sin clave, experimentales. Activar también "permitir fuentes experimentales" en la búsqueda.
RYANAIR_ENABLED=false
# FlightFinder y fast-flights requieren INSTALL_EXPERIMENTAL=true y reconstruir imagen.
INSTALL_EXPERIMENTAL=false
FLIGHTFINDER_ENABLED=false
FAST_FLIGHTS_ENABLED=false
# Último recurso opcional: Chromium local (instalación más pesada).
INSTALL_BROWSER=false
GOOGLE_BROWSER_ENABLED=false
GOOGLE_BROWSER_MAX_CALLS_PER_RUN=2

# Llamadas a adaptadores, no unidades de facturación HTTP del proveedor.
# Cada reintento consume otra llamada. Algunas llamadas realizan 2 peticiones HTTP.
PROVIDER_MAX_CALLS_PER_RUN=10
PROVIDER_MONTHLY_CALL_LIMIT=500
PROVIDER_TIMEOUT_SECONDS=25
SEARCH_TIMEOUT_SECONDS=120
CACHE_TTL_SECONDS=900

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
