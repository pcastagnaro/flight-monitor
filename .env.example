FLIGHTPOWERS_API_KEY=
SERPAPI_API_KEY=
TRAVELPAYOUTS_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# https://rapidapi.com/DataCrawler/api/google-flights2
DATACRAWLER_API_KEY=
DATACRAWLER_MAX_REQUESTS_PER_RUN=5

# Nivel de logs del backend y worker (copiar a .env y recrear los servicios).
# Valores, de más a menos detalle; cada nivel incluye los de mayor gravedad:
# DEBUG: consultas por proveedor, resultados y límites de peticiones.
# INFO: inicio/fin de búsquedas, totales y actividad del worker (predeterminado).
# WARNING: avisos, como el uso del modo demo.
# ERROR: fallos de proveedores o ejecuciones. CRITICAL: solo fallos críticos.
# Se aceptan minúsculas; un valor inválido impide el arranque.
# Salida a consola: docker compose logs -f backend worker
LOG_LEVEL=INFO
